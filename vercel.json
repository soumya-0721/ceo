{
  "version": 2,
  "installCommand": "cd ceo-dashboard/backend && npm install",
  "buildCommand": "cd ceo-dashboard/backend && npm run build",
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "ceo-dashboard/backend/dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
