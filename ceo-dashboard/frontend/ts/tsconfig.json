{
    "compilerOptions": {
        "target": "ES2020",
        "module": "none",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "rootDir": ".",
        "strict": false,
        "skipLibCheck": true,
        "noEmitOnError": false,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["*.ts"]
}
