# Next360 CEO Command Center - backend configuration (EXAMPLE).
# Copy this file to `.env` for local development and fill in real values.
# `.env` is gitignored - NEVER commit real secrets.

PORT=3000
NODE_ENV=development

# REQUIRED in production. Must be a strong, unique random value of at least 32
# characters. Startup fails closed in production if this is missing or weak.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Database (hosted PostgreSQL / Neon).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Scheduling migration guard (see src/lib/migrationGuard.ts).
# Only set these to run `npm run migrate:scheduling`, and only with explicit approval.
# ALLOW_SCHEDULING_MIGRATION=false
# MIGRATION_EXPECTED_DB_NAME=
# MIGRATION_EXPECTED_DB_USER=
